    text-align: center;
    overflow: hidden;
    background:
      radial-gradient(
        ellipse 90% 60% at 50% -10%,
        color-mix(in srgb, var(--ln-accent) 16%, transparent),
        transparent 70%
      ),
      var(--ln-bg);
  }

  .hero-title {
    font-size: var(--ln-step-display);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 680;
    max-width: 16ch;
    margin-inline: auto;
    text-wrap: balance;
  }

  .hero-sub {
    font-size: var(--ln-step-lead);
    line-height: 1.55;
    color: var(--ln-fg-dim);
    max-width: 52ch;
    margin: 1.5rem auto 0;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 2.25rem;
  }

  .hero-facts {
    list-style: none;
    padding: 0;
    margin: 1.6rem auto 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    font-size: 0.975rem;
    color: var(--ln-fg-dim);
  }
  .hero-facts strong {
    color: var(--ln-fg);
    font-weight: 640;
  }
  /* Separators only while the row genuinely fits on one line. `li + li::before` fires on
     every item regardless of where the flex line breaks, so on a phone the dots ended up
     dangling at the START of the wrapped lines. Below the breakpoint the facts stack and
     the separators go away entirely. */
  @media (max-width: 47.9rem) {
    .hero-facts {
      flex-direction: column;
      gap: 0.35rem;
    }
  }
  @media (min-width: 48rem) {
    .hero-facts li {
      position: relative;
    }
    .hero-facts li + li::before {
      content: '·';
      position: absolute;
      left: -0.8rem;
      color: var(--ln-fg-faint);
    }
  }

  .hero-note {
    margin-top: 0.85rem;
  }

  /* --- Hero rail + shot ---------------------------------------------------
     The rail is the page's contents list, in the fold, beside the screenshot.
     One narrow column rather than a grid: a grid of seven competes with the h1
     for the eye, where a single column reads as an index and is skimmed in one
     pass down the left edge.

     No padding-inline on this wrapper: .hero is a .ln-band and already applies
     the gutter, so adding it again insets the shot 16px INSIDE the content
     column it is supposed to overhang by 3rem.
  ---------------------------------------------------------------------- */

  .hero-lower {
    max-width: calc(var(--ln-max) + 6rem);
    margin: clamp(2.25rem, 4vw, 3.25rem) auto 0;
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.75rem);
    /* The hero centres its copy; the rail is a list and must not inherit that. */
    text-align: start;
  }

  @media (min-width: 64rem) {
    .hero-lower {
      grid-template-columns: minmax(0, 19rem) minmax(0, 1fr);
      align-items: start;
    }
  }

  .hero-rail {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .rail-item {
    display: block;
    padding: 0.55rem 0.7rem;
    border: 1px solid transparent;
    border-radius: 0.55rem;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }
  .rail-item:hover {
    background: color-mix(in srgb, var(--ln-accent) 8%, transparent);
  }

  .rail-text {
    display: block;
    min-width: 0;
  }
  .rail-text strong {
    display: block;
    font-size: 0.975rem;
    font-weight: 640;
    line-height: 1.3;
    letter-spacing: -0.012em;
    color: var(--ln-fg);
    text-wrap: pretty;
  }
  /* The arrow belongs to the last word, not to a floated span: it must wrap with
     the text rather than stranding itself on a line of its own. */
  .rail-text strong::after {
    content: ' →';
    color: var(--ln-accent);
    font-weight: 500;
  }
  .rail-blurb {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--ln-fg-dim);
    text-wrap: pretty;
  }

  /* A row that is a tab for the picture: no arrow (it does not leave the fold on a desktop),
     and the one shown carries an accent bar. Below 64rem it is a link like the others, so
