  .rail-item--shot {
    border-left: 2px solid transparent;
    border-radius: 0 0.55rem 0.55rem 0;
  }
  .rail-item--shot[aria-current='true'] {
    border-left-color: var(--ln-accent);
    background: color-mix(in srgb, var(--ln-accent) 8%, transparent);
  }
  @media (min-width: 64rem) {
    .rail-item--shot .rail-text strong::after {
      content: none;
    }
  }

  /* The shots stack in one frame and the chosen one fades in over the rest. */
  .hero-shot .ln-shot {
