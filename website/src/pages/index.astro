---
/**
 * The landing page.
 *
 * Deliberately outside the Starlight docs collection: `/features` and `/guides`
 * keep Starlight's chrome, and `src/pages/` takes route priority over
 * Starlight's injected routes, so this owns `/` with no collision.
 *
 * House rule for the copy here: one idea per band, a statement headline, at
 * most three short paragraphs, one visual. Every band ends with a link to the
 * docs page that carries the detail — if a paragraph is explaining lane
 * semantics or flag behaviour, it belongs there, not here.
 */
import Landing from '../layouts/Landing.astro';
import Faq from '../components/landing/Faq.astro';

const title = 'maiTerm — keep a window full of coding agents on track';
const description =
  'A terminal for running Claude Code, Codex and your shells side by side: a kanban board shared with your agents, a rules-driven supervisor watching the window, and every tab back exactly as it was after a restart.';

const EVERYTHING = [
  {
    title: 'Restart without losing anything',
    body: 'Reboot the machine and every tab comes back as it was — scrollback, layout, SSH sessions, agent sessions — each resumed agent reconnected to its tab with nothing typed by anyone.',
  },
  {
    title: 'Know what is in every tab',
    body: 'Interpolated names like <code>CustomName %title</code> combine your label with live terminal state. No more guessing across fifteen identical “bash” tabs.',
  },
  {
    title: 'Workspaces per project',
    body: 'Group terminals by project, each with its own pane layout and context. Suspend the inactive ones to free resources; they resume with full state.',
  },
  {
    title: 'Bridge two agents',
    body: 'Connect two running sessions — one local, one over SSH, a Claude Code and a Codex — so they ask each other questions directly, in a split pane you can watch.',
  },
  {
    title: 'A composer, not a shell line',
    body: 'A multi-line dock under every terminal. Enter makes newlines, <code>Cmd+Enter</code> sends, drafts survive restarts, and pasted screenshots become attachments — uploaded automatically over SSH.',
  },
  {
    title: 'Built-in editor',
    body: 'Click any file path in terminal output to open it in an editor tab — over SSH too, loaded transparently. 50+ languages, with an inline merge view when a file changes under your unsaved edits.',
  },
  {
    title: 'Deshittify your agent',
    body: 'One Preferences section switches off the parts of a coding agent that serve its vendor: telemetry, error uploads, feedback nags, and the <code>Co-Authored-By</code> trailer in your history.',
  },
  {
    title: 'A Rust terminal underneath',
    body: 'alacritty_terminal does VTE parsing, buffering and scrollback in the backend, so the frontend only ever paints one screen. Scrollback persists to SQLite, crash-safe.',
  },
];
---

<Landing title={title} description={description} path="/">
  {/* ---------------------------------------------------------------- Hero */}
  <section class="ln-band ln-band--flush hero">
    <div class="ln-inner">
      <p class="ln-eyebrow">A terminal for multi-agent work</p>
      <h1 class="hero-title">Keep a window full of agents on track</h1>
      <p class="hero-sub">
        maiTerm runs Claude Code, Codex and your shells side by side — then shares a real
        kanban board with them, supervises them against rules you write, and brings every tab
        back exactly as it was. No LLM inside, no chat sidebar.
      </p>

      <div class="hero-actions">
        <a class="ln-btn ln-btn--primary ln-btn--lg" href="/download/">Download maiTerm</a>
        <a class="ln-btn ln-btn--ghost ln-btn--lg" href="/guides/getting-started/">Get started</a>
      </div>
      {/* The strongest honest thing we can say to someone who has never heard of us, and
          it was a grey footnote: Warp wants an account, Solo wants $99/yr past four
          projects. Give it the weight it earns. */}
      <ul class="hero-facts">
        <li><strong>Free</strong> — every feature, no paid tier</li>
        <li><strong>No account</strong> — nothing to sign up for</li>
        <li><strong>Source published</strong></li>
      </ul>
      <p class="ln-note hero-note">macOS, Windows and Linux.</p>
    </div>

    <div class="hero-shot">
      <div class="ln-shot">
        <img
          src="/screenshots/overlord-board.webp"
          alt="maiTerm's Overlord board: a triage queue of agents needing attention, and a fleet card per agent showing its context ring and live state"
          width="2400"
          height="1500"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------- Progression */}
  <section class="ln-band ln-band--raised">
    <div class="ln-inner">
      <p class="ln-eyebrow">Start with what you know</p>
      <h2 class="ln-h2 ln-h2--wide">It is a terminal first. The rest waits until you want it.</h2>
      <p class="ln-lead">
        Nothing here asks you to change how you work on day one. Open a project, run a shell,
        keep moving — and turn on the parts that manage a desk full of agents when you
        actually have one.
      </p>

      <ol class="steps">
        <li>
          <span class="steps-when">Day one</span>
          <h3>A terminal that feels familiar</h3>
          <p>
            Tabs, splits, search, themes, a real editor on any file path. Fast, native, and
            small — Tauri 2 and the system webview, not a bundled browser.
          </p>
        </li>
        <li>
          <span class="steps-when">As you settle in</span>
          <h3>Your projects become workspaces</h3>
          <p>
            Group tabs by project with their own layout and context. Suspend what you are not
            using. Restart the machine and find all of it exactly where you left it.
          </p>
        </li>
        <li>
          <span class="steps-when">When you are ready</span>
          <h3>Your agents get a shared desk</h3>
          <p>
            One kanban board both sides work, a supervisor watching the whole window, agents
            that can talk to each other, and ways in from your phone and your team's chat.
          </p>
        </li>
      </ol>
    </div>
  </section>

  {/* --------------------------------------------------------------- Stack */}
  {/* .ln-cards sits OUTSIDE the text block on purpose: `.ln-stack > :first-child`
      caps at 46rem, which drops the three-card grid to two columns. */}
  <section class="ln-band">
    <div class="ln-inner ln-stack">
    <div>
      <p class="ln-eyebrow">Workspace stack</p>
      <h2 class="ln-h2 ln-h2--wide">One dev server, however many agents.</h2>
      <p class="ln-lead">
        Every project has things that must be running before any of it works — a dev server,
        an API, a database, a queue worker. You start them by hand in four tabs, lose track of
        which one died, and then an agent starts a fifth copy of the dev server because nothing
        ever told it the first one was up.
      </p>
      <p class="ln-lead">
        A workspace can just <strong>say what its project runs</strong>. maiTerm starts each
        service, watches its exit code, brings it back when it crashes, and shows the set under
        the workspace with a rollup dot that goes green only once every service meant to start
        with it has — never because one of them did. Click one and its console opens
        <em>over</em> your work — a drawer along the bottom,
        never a dock that steals width from the tab you are typing in. Click away and it is gone.
      </p>
      <p class="ln-lead">
        It knows <strong>where</strong>, too. A dev server announces its address the moment it
        comes up, so maiTerm reads it off the output and fills it in — no sockets sniffed, no
        configuration. Shift-click the row to open it in your browser.
      </p>
      <p class="ln-lead">
        The stack belongs to the workspace, so <strong>every agent in it sees the same one</strong>.
        On a mesh workspace that is sixteen agents and still one dev server: each session is told
        what is running and where — <code>web (ready, http://localhost:5173), api (crashed)</code>
        — and eleven tools let them read a failing service's log, restart it, and wait for it to
        come up before they call it.
      </p>
      <a class="ln-cta-link" href="/features/stack/">How the stack works</a>
    </div>

    <div class="ln-shot">
      <img
        src="/screenshots/stack-console.webp"
        alt="A maiTerm workspace running three services — web-ui on port 5173, api-gateway on 4000 and a worker — with one service's console open in a drawer over the terminal, showing the dev server's own line announcing its address"
        width="2400"
        height="1500"
        loading="lazy"
      />
    </div>

    <div class="ln-cards">
        <div class="ln-card">
          <h3>It reads the project first</h3>
          <p>
            Point it at a directory and it offers what is already declared —
            <code>package.json</code> scripts through whichever package manager your lockfile
            implies, a <code>Procfile</code>, the services in a compose file, a
            <code>justfile</code> or <code>Makefile</code>. Tick what you want.
          </p>
        </div>
        <div class="ln-card">
          <h3>A service is a real tab</h3>
          <p>
            Not a process hidden behind a panel — a terminal, with real scrollback, colour and
            a TUI that renders properly. It just has no slot in your tab strip, so no
            stray <code>Cmd+W</code> can take your database down with it.
          </p>
        </div>
        <div class="ln-card">
          <h3>Crashes, within reason</h3>
          <p>
            A service that dies comes back on its own, waiting longer each time. After five
            restarts in ten minutes it stops and says so on the row, rather than thrashing all
            afternoon against something that is not going to start.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------------- Tasks */}
  <section class="ln-band ln-band--raised">
    <div class="ln-inner ln-stack">
      <div>
        <p class="ln-eyebrow">Task board</p>
        <h2 class="ln-h2 ln-h2--wide">A real kanban board, shared with your agents</h2>
        <p class="ln-lead">
          Agents keep private to-do lists. You watch one scroll past in a terminal, and that is
          the whole relationship — no way to add an item, correct one, or see across a window
          what is actually in flight.
        </p>
        <p class="ln-lead">
          <strong>maiTerm owns that state now.</strong> Seven lanes, with
          <strong>workstreams</strong> keeping the unrelated jobs inside one project apart.
          <strong>Dependencies that genuinely hold</strong>: a prerequisite parked in the
          backlog still blocks what is waiting on it, and a task an agent
          <em>retracts</em> pointedly does not satisfy its dependents the way finishing one
          does. Assign a row to a tab, or leave it unassigned for whoever picks it up.
        </p>
        <p class="ln-lead">
          Every row carries a spec and an <strong>append-only log</strong> beneath it, where
          each entry is stamped with who actually wrote it rather than who claims to have.
        </p>

        <ol class="lanes" aria-label="The seven lanes">
          <li data-lane="backlog">Backlog</li>
          <li data-lane="todo">To-do</li>
          <li data-lane="active">Active</li>
          <li data-lane="blocked">Blocked</li>
          <li data-lane="review">Review</li>
          <li data-lane="done">Done</li>
          <li data-lane="dropped">Dropped</li>
        </ol>

        <p class="ln-lead">
          Open it with <code>Cmd+Shift+E</code>: add, retitle, annotate, park, reassign, or hand
          a row over with <strong>Do it</strong>. The agent sees every one of those edits
          through the same tools it writes with — and none of the three lets it delete a row.
          Work it misread gets <em>retracted</em> to Dropped, which you can reverse; removing
          one for good stays yours.
        </p>
        <a class="ln-cta-link" href="/features/tasks/">How the board works</a>
      </div>
      <div class="ln-shot">
        <img
          src="/screenshots/tasks-panel.webp"
          alt="The maiTerm task panel docked beside a terminal, showing tasks grouped into lanes and attributed to the agent working them"
          width="2400"
          height="1500"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ Overlord */}
  <section class="ln-band">
    <div class="ln-inner">
      <p class="ln-eyebrow">Overlord</p>
      <h2 class="ln-h2">A supervisor for a window full of agents</h2>
      <p class="ln-lead">
        With a dozen agents running, what you lose is not any single answer — it is track.
        Which tab is about to hit a compaction wall, which has been sitting at a permission
        prompt for twenty minutes, which one quietly stopped being connected at all.
      </p>
      <p class="ln-lead">
        A rule is a condition and a sequence: <em>when context reaches 55%, tell the agent to
        update its docs, then to prepare for compaction, then <code>/compact</code></em> —
        waiting for each step to genuinely land before sending the next.
        <strong>No model sits in that loop</strong>, so it is predictable and costs nothing to
        run.
      </p>

      <div class="ln-cards">
        <div class="ln-card">
          <h3>Held for your approval</h3>
          <p>
            Overlord types with your authority, so propose mode is on out of the box: every
            directive waits for you, showing the exact words it would send. Your own keystrokes
            abort a sequence already in progress.
          </p>
        </div>
        <div class="ln-card">
          <h3>An operations deck</h3>
          <p>
            <strong>Triage</strong> is one severity-ordered queue of everything wanting a
            person. <strong>Fleet</strong> is a card per agent. <strong>Ledger</strong> is a
            verbatim record of every directive sent and what came back.
          </p>
        </div>
        <div class="ln-card">
          <h3>Rules you actually tune</h3>
          <p>
            Conditions fire on semantic state — context, commits, idle time, stale tasks,
            waiting permission prompts — not on scraped terminal output. Scoped globally or per
            workspace.
          </p>
        </div>
      </div>
      <a class="ln-cta-link" href="/features/overlord/">How Overlord works</a>
    </div>
  </section>

  {/* ---------------------------------------------------------------- Mesh */}
  <section class="ln-band ln-band--raised">
    <div class="ln-inner ln-stack">
      <div>
        <p class="ln-eyebrow">Mesh workspace</p>
        <h2 class="ln-h2">A team of specialists, not one giant context</h2>
        <p class="ln-lead">
          Flip a workspace into a <strong>mesh</strong> and every agent in it can message any
          other by role. The frontend agent asks the backend agent for an endpoint's exact
          shape, the backend loops in infra, and nobody waits for you to play messenger.
        </p>
        <p class="ln-lead">
          It is also a token win. One monolithic agent drags every codebase into a single
          enormous context and re-reads it turn after turn. A mesh keeps each agent's context
          small and sharply scoped, and they trade short addressed messages instead of
          duplicating each other's worlds.
        </p>
        <a class="ln-cta-link" href="/features/mesh-workspace/">How mesh works</a>
      </div>
      <div class="ln-stack-visual mesh-shot">
        <img
          src="/screenshots/mesh-cockpit.webp"
          alt="The maiTerm mesh cockpit: a node graph of six specialist agents, the topics they are collaborating on with turn counts, and a status board"
          width="820"
          height="1230"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- maiLink */}
  <section class="ln-band">
    <div class="ln-inner ln-split">
      <div>
        <p class="ln-eyebrow">maiLink companion</p>
        <h2 class="ln-h2">Your agents, in your pocket. No cloud in the middle.</h2>
        <p class="ln-lead">
          A phone app that connects <strong>directly to maiTerm on your own computer</strong>.
          Watch agents work, answer their questions, approve permissions, and interrupt a
          runaway turn — from the couch, the garden, anywhere in the house.
        </p>
        <p class="ln-lead">
          It writes, too: work the shared board — move a card between lanes, retitle or
          reassign one — approve an Overlord proposal, rename or archive a tab, wake a
          suspended workspace.
        </p>
        <p class="ln-lead">
          It travels over <strong>your LAN only</strong>, on an encrypted, authenticated
          channel. The single exception is a content-free push doorbell that wakes the app
          carrying nothing but a tab name and an event kind — never a transcript.
        </p>
        <a class="ln-cta-link" href="/features/mailink/">How maiLink works</a>
      </div>
      <div class="ln-phones">
        <img
          src="/screenshots/mailink-inbox.webp"
          alt="maiLink on iPhone: an inbox of agents, with the ones needing attention pinned to the top"
          width="860"
          height="1290"
          loading="lazy"
        />
        <img
          src="/screenshots/mailink-answer.webp"
          alt="Answering an agent's question from a phone: pick an option or type a free-text reply"
          width="860"
          height="1290"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- Chat threads */}
  {/* Promoted out of the nine-card grid on 2026-09-13: work arriving from your
      team and leaving answered is a whole axis, and one card could not carry it.
      No screenshot here on purpose — a real Mattermost thread is a customer bug
      report with real usernames on it, and staging a fake one convincingly is a
      bigger job than this band is worth. */}
  <section class="ln-band ln-band--raised">
    <div class="ln-inner">
      <p class="ln-eyebrow">Chat threads</p>
      <h2 class="ln-h2 ln-h2--wide">The bug report never has to leave the thread it landed in.</h2>
      <p class="ln-lead">
        A customer problem shows up in a Mattermost thread. Normally you read it, switch to
        your editor, reproduce it, fix it, then come back and write up what you did. Point a
        tab at that channel instead: set up a bot account once, and an <code>@mention</code> of
        it hands that tab the thread — the conversation so far, plus the screenshots, logs and
        documents staged as real files on disk — to work in <em>that tab's repository</em>.
      </p>
      <p class="ln-lead">
        The channel keeps flowing normally. Only messages that <code>@mention</code> the bot are
        delivered into the session, so the agent answers deliberate asks rather than reacting to
        everything said near it.
      </p>
      <p class="ln-lead">
        It replies before it investigates — its one-line read of what is being asked, and how to
        reach it again — so a misunderstanding surfaces immediately instead of ten minutes later
        in the shape of the wrong fix. Then it goes quiet, works, and posts the resolution in two
        halves: plain language for whoever is talking to the customer, and the root cause below
        the divider for the devs.
      </p>

      <div class="ln-cards">
        <div class="ln-card">
          <h3>Support can ask, not authorize</h3>
          <p>
            Who may summon the bot is enforced in Preferences — an <code>@mention</code> from
            anyone else never reaches an agent. Above that, every delivered message arrives
            tagged with its sender's tier and a standing rule: reading is free, but changing
            code, deploying or touching data goes back to someone you named.
          </p>
        </div>
        <div class="ln-card">
          <h3>Six threads, and a kill switch</h3>
          <p>
            One tab works up to six at once and queues the rest, telling a waiting thread it is
            at capacity rather than leaving people wondering. The tab's right-click menu ends a
            binding — every one of them on a busy tab — without the agent's cooperation.
          </p>
        </div>
        <div class="ln-card">
          <h3>It can start the conversation</h3>
          <p>
            A regression it tripped over, a heads-up before a deploy, a question only a person
            can settle — the agent opens its own thread in a channel you put on that tab's
            list, <code>@mentions</code> whoever should see it, and stays bound for the replies.
          </p>
        </div>
      </div>
      <a class="ln-cta-link" href="/features/comms/">How chat threads work</a>
    </div>
  </section>

  {/* ------------------------------------------------------ Compatibility */}
  <section class="ln-band ln-band--sunken ln-band--tight">
    <div class="ln-inner compat">
      <p class="compat-label">
        Runs the agent CLIs<br />you already have installed
      </p>
      <ul class="compat-list">
        <li>Claude Code</li>
        <li>OpenAI Codex</li>
        <li>Local shells</li>
        <li>SSH hosts</li>
        <li>macOS</li>
        <li>Windows</li>
        <li>Linux</li>
      </ul>
    </div>
  </section>

  {/* ----------------------------------------------------- Everything else */}
  <section class="ln-band">
    <div class="ln-inner">
      <p class="ln-eyebrow">The daily work</p>
      <h2 class="ln-h2 ln-h2--wide">The rest of it still has to be a good terminal.</h2>
      <p class="ln-lead">
        Orchestration is worth nothing if the thing you sit in front of all day is annoying.
      </p>

      <div class="ln-cards grid-tight">
        {
          EVERYTHING.map((f) => (
            <div class="ln-card">
              <h3>{f.title}</h3>
              <p set:html={f.body} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------- Price */}
  <section class="ln-band ln-band--raised">
    <div class="ln-inner">
      <p class="ln-eyebrow">What it costs</p>
      <h2 class="ln-h2 ln-h2--wide">Free. All of it. There is no tier above this one.</h2>
      <p class="ln-lead">
        Not free-for-four-projects, not free-until-you-need-the-good-part. Overlord, mesh,
        the shared board, chat threads, the phone companion, SSH — every feature on this page
        is in the build you download, and there is nothing to buy later.
      </p>

      <div class="ln-cards">
        <div class="ln-card">
          <h3>No account</h3>
          <p>
            No sign-in, no licence key, no activation limit, no seat count. Download it and it
            works. It does not know who you are.
          </p>
        </div>
        <div class="ln-card">
          <h3>Works offline</h3>
          <p>
            There is no licence check to phone home to. The only request maiTerm makes on its
            own behalf is looking for a new version.
          </p>
        </div>
        <div class="ln-card">
          <h3>The source is published</h3>
          <p>
            Read it, build it, change it. Source available rather than OSI open source: the
            one restriction is that you may not use it to build a competing terminal.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------------- FAQ */}
  <Faq />

  {/* ----------------------------------------------------------- Final CTA */}
  <section class="ln-band ln-band--raised final">
    <div class="ln-inner ln-inner--narrow">
      <h2 class="ln-h2 final-title">
        Give every agent on your desk the same place to work.
      </h2>
      <p class="ln-lead final-lead">
        Start with a terminal. Turn on the supervisor when the desk gets busy.
      </p>
      <div class="hero-actions final-actions">
        <a class="ln-btn ln-btn--primary ln-btn--lg" href="/download/">Download maiTerm</a>
        <a class="ln-btn ln-btn--ghost ln-btn--lg" href="https://github.com/Flexmark-Intl/maiterm">
          View on GitHub
        </a>
      </div>
      <p class="ln-note">Free, source available. macOS, Windows and Linux.</p>
    </div>
  </section>
</Landing>

<style>
  /* --- Hero -------------------------------------------------------------- */

  .hero {
    /* Tighter than a standard band on purpose: the screenshot has to reach
       into the fold to read as a running app rather than a framed picture. */
    padding-block: clamp(2.75rem, 5vw, 4.25rem) 0;
    text-align: center;
    overflow: hidden;
    background:
      radial-gradient(
        ellipse 90% 60% at 50% -10%,
        color-mix(in srgb, var(--ln-accent) 16%, transparent),
        transparent 70%
      ),
      var(--ln-bg);
  }

  .hero-title {
    font-size: var(--ln-step-display);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 680;
    max-width: 16ch;
    margin-inline: auto;
    text-wrap: balance;
  }

  .hero-sub {
    font-size: var(--ln-step-lead);
    line-height: 1.55;
    color: var(--ln-fg-dim);
    max-width: 52ch;
    margin: 1.5rem auto 0;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 2.25rem;
  }

  .hero-facts {
    list-style: none;
    padding: 0;
    margin: 1.6rem auto 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    font-size: 0.975rem;
    color: var(--ln-fg-dim);
  }
  .hero-facts strong {
    color: var(--ln-fg);
    font-weight: 640;
  }
  /* Separators only while the row genuinely fits on one line. `li + li::before` fires on
     every item regardless of where the flex line breaks, so on a phone the dots ended up
     dangling at the START of the wrapped lines. Below the breakpoint the facts stack and
     the separators go away entirely. */
  @media (max-width: 47.9rem) {
    .hero-facts {
      flex-direction: column;
      gap: 0.35rem;
    }
  }
  @media (min-width: 48rem) {
    .hero-facts li {
      position: relative;
    }
    .hero-facts li + li::before {
      content: '·';
      position: absolute;
      left: -0.8rem;
      color: var(--ln-fg-faint);
    }
  }

  .hero-note {
    margin-top: 0.85rem;
  }

  /* The shot is cropped by the fold on purpose: it reads as a running app you
