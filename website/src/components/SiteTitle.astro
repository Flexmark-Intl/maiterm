---
/**
 * Overrides Starlight's SiteTitle so the header wordmark can be duo-tone.
 *
 * Starlight renders the title as a bare text node, and CSS cannot colour half
 * of one — so the split has to happen in markup. Everything else here is
 * upstream's component verbatim (the logo <img> block and its styles); keep it
 * in step if Starlight's changes.
 */
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;

// "mai" in Poppins Bold in stone, "term" in Poppins SemiBold (lowercased in CSS)
// in ink — the house-style split the app icon uses (scripts/make-brand.py).
// Matched exactly, not by prefix: each face is subset to its half's glyphs
// ("mai", "term"), so a sibling name like "maiLink" would take `mai` from
// Poppins and the rest from the fallback stack — one word, two sets of
// letterforms. Any other title falls through to plain text instead.
const wordmark = siteTitle === 'maiTerm' ? ['mai', 'Term'] : null;
---

<a href={siteTitleHref} class="site-title sl-flex">
	{
		config.logo && logos.dark && (
			<>
				<img
					class:list={{ 'light:sl-hidden print:hidden': !('src' in config.logo) }}
					alt={config.logo.alt}
					src={logos.dark.src}
					width={logos.dark.width}
					height={logos.dark.height}
				/>
				{/* Show light alternate if a user configure both light and dark logos. */}
				{!('src' in config.logo) && (
					<img
						class="dark:sl-hidden print:block"
						alt={config.logo.alt}
						src={logos.light?.src}
						width={logos.light?.width}
						height={logos.light?.height}
					/>
				)}
			</>
		)
	}
	<span class:list={{ 'sr-only': config.logo?.replacesTitle }} translate="no">
		{
			wordmark ? (
				<span class="wordmark"><span class="wm-mai">{wordmark[0]}</span><span class="wm-term">{wordmark[1]}</span></span>
			) : (
				siteTitle
			)
		}
	</span>
</a>

<style>
	.site-title {
		align-items: center;
		gap: var(--sl-nav-gap);
		font-size: var(--sl-text-h4);
		font-weight: 600;
		color: var(--sl-color-text-accent);
		text-decoration: none;
		white-space: nowrap;
	}
	img {
		height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
		width: auto;
		max-width: 100%;
		object-fit: contain;
		object-position: 0 50%;
	}
</style>
