---
/**
 * Marketing nav. Replaces the docs chrome (a search box, a theme dropdown and
 * a GitHub icon — no destinations at all) with somewhere to go.
 *
 * The mobile menu is a <details>, deliberately: it works with JS off, Escape
 * and click-outside are the only behaviours worth scripting, and there is no
 * focus trap to get wrong.
 */
const LINKS = [
  { label: 'Features', href: '/features/terminal/' },
  { label: 'Agents', href: '/features/agents/' },
  { label: 'Compare', href: '/compare/' },
  { label: 'Docs', href: '/guides/getting-started/' },
];
---

<header class="nav">
  <div class="nav-inner">
    <a class="nav-brand" href="/">
      <img src="/favicon.png" alt="" width="26" height="26" />
      <span class="ln-wordmark"><span class="wm-mai">mai</span><span class="wm-term">Term</span></span>
    </a>

    <nav class="nav-links" aria-label="Main">
      {LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav-actions">
      <button class="nav-icon" type="button" data-theme-toggle aria-label="Toggle colour theme">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
      </button>

      <a class="nav-icon" href="https://github.com/Flexmark-Intl/maiterm" aria-label="maiTerm on GitHub">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 012-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>

      <a class="ln-btn ln-btn--primary nav-download" href="/download/">Download</a>

      <details class="nav-menu">
        <summary aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </summary>
        <div class="nav-menu-panel">
          {LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href="/download/">Download</a>
        </div>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const btn = document.querySelector('[data-theme-toggle]');
    if (btn) {
      btn.addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {
          /* Blocked storage: the toggle still works for this page view. */
        }
      });
    }

    // Close the mobile menu on Escape or an outside click. Without this it
    // stays open behind whatever the visitor taps next.
    const menu = document.querySelector('.nav-menu');
    if (menu) {
      document.addEventListener('click', (e) => {
        if (menu.open && !menu.contains(e.target)) menu.open = false;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    }
  })();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--ln-bg) 86%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--ln-border);
    /* The gutter belongs on the OUTER element, as it does on .ln-band and
       .foot. Putting it on .nav-inner as well ate it out of the max-width, so
       past 1180px the wordmark sat a full gutter inboard of the headline
       directly beneath it. */
    padding-inline: var(--ln-gutter);
  }

  .nav-inner {
    max-width: var(--ln-max);
    margin-inline: auto;
    padding-block: 0.75rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.2rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .nav-brand img {
    border-radius: 0.35rem;
  }

  .nav-links {
    display: none;
    gap: 1.6rem;
    margin-inline-start: 0.75rem;
    flex: 1;
  }
  .nav-links a {
    color: var(--ln-fg-dim);
    text-decoration: none;
    font-size: 0.975rem;
    font-weight: 500;
    transition: color 0.15s ease;
  }
  .nav-links a:hover {
    color: var(--ln-fg);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
  }

  .nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 0.45rem;
    border: 1px solid transparent;
    background: none;
    color: var(--ln-fg-dim);
    cursor: pointer;
    text-decoration: none;
  }
  .nav-icon:hover {
    color: var(--ln-fg);
    border-color: var(--ln-border-strong);
  }

  /* One button, two glyphs — show whichever the *next* click produces. */
  .icon-sun {
    display: none;
  }
  :global(html[data-theme='light']) .icon-sun {
    display: none;
  }
  :global(html[data-theme='light']) .icon-moon {
    display: block;
  }
  :global(html[data-theme='dark']) .icon-sun {
    display: block;
  }
  :global(html[data-theme='dark']) .icon-moon {
    display: none;
  }

  .nav-download {
    display: none;
    padding: 0.5rem 1.05rem;
    font-size: 0.95rem;
  }

  .nav-menu {
    position: relative;
  }
  .nav-menu summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 0.45rem;
    color: var(--ln-fg-dim);
    cursor: pointer;
  }
  .nav-menu summary::-webkit-details-marker {
    display: none;
  }
  .nav-menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    min-width: 12rem;
    display: flex;
    flex-direction: column;
    padding: 0.4rem;
    border: 1px solid var(--ln-border-strong);
    border-radius: 0.6rem;
    background: var(--ln-bg-raised);
    box-shadow: var(--ln-shadow);
  }
  .nav-menu-panel a {
    padding: 0.6rem 0.75rem;
    border-radius: 0.4rem;
    color: var(--ln-fg);
    text-decoration: none;
    font-weight: 500;
  }
  .nav-menu-panel a:hover {
    background: var(--ln-bg-sunken);
  }

  @media (min-width: 52rem) {
    .nav-links {
      display: flex;
    }
    .nav-download {
      display: inline-flex;
    }
    .nav-menu {
      display: none;
    }
  }
</style>
