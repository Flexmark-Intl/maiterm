---
/**
 * Shell for the hand-authored marketing pages (`/`, `/compare/*`).
 *
 * Starlight owns /features and /guides and brings its own <html>; these pages
 * are plain Astro and bring their own. The one thing they must agree on is the
 * theme contract — `data-theme` on <html>, persisted under the
 * `starlight-theme` localStorage key — so toggling here and then clicking into
 * the docs doesn't flip the page back.
 */
import '../styles/landing.css';
import Nav from '../components/landing/Nav.astro';
import Footer from '../components/landing/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Page-specific canonical path, e.g. "/compare/warp/". */
  path?: string;
}

const { title, description, path = '/' } = Astro.props;
const canonical = new URL(path, Astro.site ?? 'https://maiterm.dev').href;
---

<!doctype html>
{/* No `data-theme` here on purpose: an attribute would be an explicit choice,
    and the CSS resolves the system preference on its own. The inline script in
    <head> stamps one before first paint for the rules that need it. */}
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Preload the wordmark: it is in the nav and the final CTA, so it paints
        in the first frame — without this it swaps in late and the nav jumps. */}
    <link
      rel="preload"
      href="/fonts/maiterm-wordmark.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Theme, before first paint. Matches Starlight's own ThemeProvider:
        `storedTheme || prefers-color-scheme`, and NOTHING is written to storage
        for a visitor who has not chosen — writing 'dark' there is what used to
        pin a light-system visitor to dark forever as if they had picked it.

        The stylesheet already resolves the OS on its own via `color-scheme:
        light dark`, so this is not what makes the page correct — it exists to
        set `data-theme` for the rules that key off it (the nav's sun/moon) and
        to honour an explicit choice. With JS off the CSS still gets it right. */}
    <script is:inline>
      (() => {
        const mq = window.matchMedia('(prefers-color-scheme: light)');
        const read = () => {
          try {
            return localStorage.getItem('starlight-theme');
          } catch {
            /* Private mode or blocked storage. */
            return null;
          }
        };
        /* Absent and Starlight's "auto" (stored as an empty string) both mean
           "no choice made" — follow the system, and keep following it. */
        const unset = (v) => v === null || v === 'auto' || v === '';
        const apply = (v) =>
          (document.documentElement.dataset.theme = unset(v)
            ? mq.matches
              ? 'light'
              : 'dark'
            : v);

        apply(read());

        // Keep following the OS while the tab stays open, the way Starlight's
        // ThemeSelect does. Without this a tab left open stays light through
        // sunset while every other window repaints dark.
        mq.addEventListener('change', () => {
          const stored = read();
          if (unset(stored)) apply(stored);
        });
      })();
    </script>
  </head>
  <body>
    <a class="ln-skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
